[sub_resource type="CapsuleShape3D" id="Capsule"]
radius = 0.4
height = 1.8

[node name="CityPreview" type="Node3D"]

[node name="Sky" parent="." instance=ExtResource("53_sky")]


[node name="Stage" type="Node3D" parent="." node_paths=PackedStringArray("City", "Player")]
script = ExtResource("1_stage")
City = NodePath("City")
Player = NodePath("../Player")

[node name="City" type="Node3D" parent="Stage"]
script = ExtResource("2_builder")
Style = ExtResource("3_style")

[node name="StreetLights" type="Node3D" parent="Stage" node_paths=PackedStringArray("City")]
script = ExtResource("54_lights")
City = NodePath("../City")

[node name="Life" type="Node" parent="Stage" node_paths=PackedStringArray("City", "Target")]
script = ExtResource("40_life")
City = NodePath("../City")
Target = NodePath("../../Player")
Traffic = ExtResource("41_traffic")
Crowd = ExtResource("42_crowd")

[node name="Traffic" type="Node3D" parent="Stage/Life"]
script = ExtResource("43_cars")
Models = Array[ExtResource("44_carmodel")]([ExtResource("45_hatch"), ExtResource("46_sedan"), ExtResource("47_van")])
Colors = PackedColorArray(0.92, 0.3, 0.3, 1, 0.3, 0.55, 0.95, 1, 1, 0.8, 0.25, 1, 0.35, 0.75, 0.45, 1, 0.95, 0.95, 0.95, 1, 0.6, 0.4, 0.85, 1)

[node name="Crowd" type="Node3D" parent="Stage/Life"]
script = ExtResource("48_crowd")
WalkerScene = ExtResource("49_walker")
Feelings = {
"annoyed": ExtResource("60_annoyed"),
"startled": ExtResource("61_surprised")
}

[node name="Citizens" type="Node" parent="Stage/Life"]
script = ExtResource("70_citizens")
Settings = ExtResource("71_citizen_settings")

[node name="Transit" type="Node" parent="Stage/Life"]
script = ExtResource("72_transit")
Settings = ExtResource("73_transit_settings")

[node name="TrafficReactions" type="Node" parent="." node_paths=PackedStringArray("Simulation", "Player")]
script = ExtResource("50_reactions")
Simulation = NodePath("../Stage/Life")
Player = NodePath("../Player")
Bruised = ExtResource("51_bruised")
Limping = ExtResource("52_limping")

[node name="Player" parent="." node_paths=PackedStringArray("InputSource", "ViewReference") groups=["player"] instance=ExtResource("4_player")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2, 0)
script = ExtResource("5_motor")
InputSource = NodePath("Input")
ViewReference = NodePath("Head")

[node name="Shape" parent="Player" index="0"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("Capsule")

[node name="Head" parent="Player" index="1"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.6, 0)

[node name="Camera" parent="Player/Head" index="0"]
current = true
fov = 80.0

[node name="Interactor" parent="Player/Head" index="1"]
script = ExtResource("6_interactor")

[node name="HoldPoint" parent="Player/Head" index="2"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.25, -0.3, -1.1)

[node name="Input" parent="Player" index="2"]
script = ExtResource("7_input")

[node name="MouseLook" parent="Player" index="3" node_paths=PackedStringArray("YawTarget", "PitchTarget")]
script = ExtResource("8_look")
YawTarget = NodePath("..")
PitchTarget = NodePath("../Head")

[node name="Sprint" parent="Player" index="4"]
script = ExtResource("9_sprint")

[node name="Jump" parent="Player" index="5"]
script = ExtResource("10_jump")

[node name="Crouch" parent="Player" index="6" node_paths=PackedStringArray("Shape", "Head")]
script = ExtResource("11_crouch")
Shape = NodePath("../Shape")
Head = NodePath("../Head")

[node name="Climb" parent="Player" index="7"]
script = ExtResource("12_climb")

[node name="Carry" parent="Player" index="8" node_paths=PackedStringArray("HoldPoint")]
script = ExtResource("13_carry")
HoldPoint = NodePath("../Head/HoldPoint")

[node name="Inventory" parent="Player" index="9"]
script = ExtResource("14_inventory")
RegisterAsGlobalService = true
StartingItems = Array[ExtResource("21_itemdef")]([ExtResource("22_phone_item")])

[node name="Meters" parent="Player" index="10"]
script = ExtResource("15_meters")
Definitions = Array[ExtResource("55_meterdef")]([ExtResource("56_wetness")])
RegisterAsGlobalService = true

[node name="StatusEffects" parent="Player" index="11"]
script = ExtResource("16_status")
RegisterAsGlobalService = true

[node name="StatusSpeed" parent="Player" index="12" node_paths=PackedStringArray("Holder")]
script = ExtResource("17_speed")
Holder = NodePath("../StatusEffects")

[node name="HardLanding" parent="Player" index="13"]
script = ExtResource("18_landing")

[node name="Hotbar" type="Node" parent="Player" node_paths=PackedStringArray("Holder", "DropPoint", "Carry")]
script = ExtResource("19_hotbar")
Holder = NodePath("../Inventory")
DropPoint = NodePath("../Head/HoldPoint")
Carry = NodePath("../Carry")
RegisterAsGlobalService = true

[node name="HeldItem" type="Node3D" parent="Player/Head" node_paths=PackedStringArray("Hotbar")]
transform = Transform3D(0.53, 0.14, 0.1, -0.14, 0.53, 0.05, -0.08, -0.07, 0.54, 0.36, -0.3, -0.6)
script = ExtResource("20_held")
Hotbar = NodePath("../../Hotbar")

[node name="World" type="Node" parent="."]
script = ExtResource("23_world")

[node name="HUD" type="CanvasLayer" parent="."]

[node name="Crosshair" type="Label" parent="HUD"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
text = "+"
horizontal_alignment = 1
vertical_alignment = 1

[node name="PromptBox" type="VBoxContainer" parent="HUD"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = 30.0
offset_top = 16.0
offset_right = 600.0
offset_bottom = 300.0
mouse_filter = 2

[node name="Prompt" type="Label" parent="HUD/PromptBox" node_paths=PackedStringArray("Interactor")]
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"HudPrompt"
script = ExtResource("24_prompt")
Interactor = NodePath("../../../Player/Head/Interactor")

[node name="ToastBox" type="CenterContainer" parent="HUD"]
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -190.0
offset_bottom = -130.0
mouse_filter = 2

[node name="Toast" type="Label" parent="HUD/ToastBox"]
layout_mode = 2
theme_type_variation = &"HudToast"
horizontal_alignment = 1
script = ExtResource("25_toast")

[node name="Hotbar" type="VBoxContainer" parent="HUD" node_paths=PackedStringArray("Hotbar")]
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -130.0
offset_bottom = -14.0
mouse_filter = 2
script = ExtResource("26_hud")
Hotbar = NodePath("../../Player/Hotbar")
Skin = ExtResource("27_skin")
CellSize = Vector2(58, 58)

[node name="Phone" type="CanvasLayer" parent="." node_paths=PackedStringArray("Hotbar", "Look")]
script = ExtResource("28_phone")
Apps = Array[ExtResource("29_appscript")]([ExtResource("30_app_map"), ExtResource("31_app_wx"), ExtResource("32_app_msg")])
Hotbar = NodePath("../Player/Hotbar")
Look = NodePath("../Player/MouseLook")
DayText = "Any day"
HomeSubtitle = "Explore the town"

[editable path="Player"]

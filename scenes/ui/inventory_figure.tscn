[ext_resource type="Script" path="res://addons/ReusableGameSystems/Appearance/CharacterIdle.cs" id="11_idle"]

[sub_resource type="Resource" id="map_sneakers"]
script = ExtResource("4_map")
ItemId = "sneakers"
Part = ExtResource("5_sneakers")

[sub_resource type="Resource" id="map_boots"]
script = ExtResource("4_map")
ItemId = "boots"
Part = ExtResource("6_boots")

[sub_resource type="Resource" id="map_slippers"]
script = ExtResource("4_map")
ItemId = "slippers"
Part = ExtResource("7_slippers")

[sub_resource type="Resource" id="map_umbrella"]
script = ExtResource("4_map")
ItemId = "umbrella"
Part = ExtResource("8_umbrella")
WhenHeld = true

[sub_resource type="Resource" id="map_phone"]
script = ExtResource("4_map")
ItemId = "phone"
Part = ExtResource("9_phone")
WhenHeld = true

[node name="InventoryFigure" type="Node3D"]

[node name="Body" type="Node3D" parent="."]
script = ExtResource("1_body")
Look = ExtResource("2_look")

[node name="Equipment" type="Node" parent="Body"]
script = ExtResource("3_parts")
Mappings = Array[ExtResource("4_map")]([SubResource("map_sneakers"), SubResource("map_boots"), SubResource("map_slippers"), SubResource("map_umbrella"), SubResource("map_phone")])

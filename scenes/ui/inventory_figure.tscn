[ext_resource type="Resource" path="res://content/characters/worn/sneakers.tres" id="5_sneakers"]
[ext_resource type="Resource" path="res://content/characters/worn/boots.tres" id="6_boots"]
[ext_resource type="Resource" path="res://content/characters/worn/slippers.tres" id="7_slippers"]
[ext_resource type="Resource" path="res://content/characters/worn/held_umbrella.tres" id="8_umbrella"]
[ext_resource type="Resource" path="res://content/characters/worn/held_phone.tres" id="9_phone"]
